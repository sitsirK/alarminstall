#!/usr/bin/env python3
"""
Hold-to-scroll for the phone's volume keys in the live installer.

Neither key repeats on its own: Vol-Up is gpio-keys without `autorepeat`, and
Vol-Down (PMIC resin, pm8941-pwrkey) has no repeat support at all; the kernel
has no uinput either. So while a volume key is held, this sends Up / Down to
the installer's tmux session itself: first after HOLD seconds, then every
INTERVAL, and faster once the key has been held for FAST_AFTER seconds.

It only reads the input devices (no grab): a short press still arrives once,
through the console keymap, exactly as before.
"""

import glob
import os
import select
import struct
import subprocess
import sys
import time

SESSION = os.environ.get('R8Q_KEYREPEAT_SESSION', 'alarminstall')
KEYS = {115: 'Up', 114: 'Down'}  # KEY_VOLUMEUP, KEY_VOLUMEDOWN
HOLD = 0.40
INTERVAL = 0.09
FAST_AFTER = 1.5
FAST_STEP = 4  # keys per tick once fast

EVENT = struct.Struct('llHHi')  # struct input_event on 64-bit: timeval, type, code, value
EV_KEY = 1


def open_devices() -> list[int]:
	fds = []
	for path in sorted(glob.glob('/dev/input/event*')):
		try:
			fds.append(os.open(path, os.O_RDONLY | os.O_NONBLOCK))
		except OSError:
			pass
	return fds


def send(key: str, count: int = 1) -> None:
	subprocess.run(['tmux', 'send-keys', '-t', SESSION, *([key] * count)], check=False, capture_output=True)


def main() -> int:
	fds = open_devices()
	if not fds:
		print('r8q-keyrepeat: no input devices', file=sys.stderr)
		return 1

	held: int | None = None
	pressed_at = 0.0
	next_at = 0.0

	while True:
		timeout = None if held is None else max(0.0, next_at - time.monotonic())
		ready, _, _ = select.select(fds, [], [], timeout)

		for fd in ready:
			try:
				data = os.read(fd, EVENT.size * 64)
			except OSError:
				continue
			for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
				_, _, etype, code, value = EVENT.unpack_from(data, off)
				if etype != EV_KEY or code not in KEYS:
					continue
				if value == 1:
					held, pressed_at = code, time.monotonic()
					next_at = pressed_at + HOLD
				elif value == 0 and code == held:
					held = None

		if held is not None and time.monotonic() >= next_at:
			fast = time.monotonic() - pressed_at >= FAST_AFTER
			send(KEYS[held], FAST_STEP if fast else 1)
			next_at = time.monotonic() + INTERVAL


if __name__ == '__main__':
	sys.exit(main())
